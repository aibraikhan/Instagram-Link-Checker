{
    "manifest_version": 3,
    "name": "Instagram Link Checker",
    "version": "3.0",
    "description": "Добавляет пометки к ссылкам на страницах Instagram.",

    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },

    "permissions": ["storage"],
    
    "host_permissions": [
        "https://3e98-2-135-25-177.ngrok-free.app/*"
    ],
    
    "background": {
        "service_worker": "background.js"
    },
    
    "content_scripts": [
        {
        "matches": ["*://*.instagram.com/*"],
        "js": ["content.js"],
        "css": ["style.css"]
        }
    ]
}